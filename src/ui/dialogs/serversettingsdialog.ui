<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ServerSettingsDialog</class>
 <widget class="QDialog" name="ServerSettingsDialog">
  <property name="windowTitle">
   <string>Server Settings</string>
  </property>
  <property name="minimumSize">
   <size>
    <width>400</width>
    <height>0</height>
   </size>
  </property>
  <layout class="QVBoxLayout" name="dialogLayout">
   <item>
    <layout class="QFormLayout" name="formLayout">
     <item row="0" column="0">
      <widget class="QLabel" name="applicationNameLabel">
       <property name="text">
        <string>Application &amp;Name</string>
       </property>
       <property name="buddy">
        <cstring>applicationNameEdit</cstring>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="ElidedLineEdit" name="applicationNameEdit"/>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="applicationUriLabel">
       <property name="text">
        <string>Application &amp;URI</string>
       </property>
       <property name="buddy">
        <cstring>applicationUriEdit</cstring>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="ElidedLineEdit" name="applicationUriEdit"/>
     </item>
     <item row="2" column="0">
      <widget class="QLabel" name="maxSessionsLabel">
       <property name="text">
        <string>&amp;Max Sessions</string>
       </property>
       <property name="buddy">
        <cstring>maxSessionsSpin</cstring>
       </property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QSpinBox" name="maxSessionsSpin">
       <property name="minimum">
        <number>1</number>
       </property>
       <property name="maximum">
        <number>65535</number>
       </property>
      </widget>
     </item>
     <item row="3" column="0">
      <widget class="QLabel" name="historyMaxValuesLabel">
       <property name="text">
        <string>&amp;History Size</string>
       </property>
       <property name="buddy">
        <cstring>historyMaxValuesSpin</cstring>
       </property>
      </widget>
     </item>
     <item row="3" column="1">
      <widget class="QSpinBox" name="historyMaxValuesSpin">
       <property name="toolTip">
        <string>Values kept per historizing variable; the oldest are dropped first</string>
       </property>
       <property name="suffix">
        <string> values</string>
       </property>
       <property name="minimum">
        <number>1</number>
       </property>
      </widget>
     </item>
     <item row="4" column="0">
      <widget class="QLabel" name="historyMaxAgeLabel">
       <property name="text">
        <string>History &amp;Retention</string>
       </property>
       <property name="buddy">
        <cstring>historyMaxAgeSpin</cstring>
       </property>
      </widget>
     </item>
     <item row="4" column="1">
      <widget class="QSpinBox" name="historyMaxAgeSpin">
       <property name="toolTip">
        <string>Drop values older than this, counted from the newest value of the variable</string>
       </property>
       <property name="specialValueText">
        <string>Unlimited</string>
       </property>
       <property name="suffix">
        <string> min</string>
       </property>
       <property name="minimum">
        <number>0</number>
       </property>
      </widget>
     </item>
     <item row="5" column="0">
      <widget class="QLabel" name="discoveryLabel">
       <property name="text">
        <string>&amp;Discovery</string>
       </property>
       <property name="buddy">
        <cstring>discoveryCheck</cstring>
       </property>
      </widget>
     </item>
     <item row="5" column="1">
      <widget class="QCheckBox" name="discoveryCheck">
       <property name="text">
        <string>Register at a Local Discovery Server</string>
       </property>
      </widget>
     </item>
     <item row="6" column="0">
      <widget class="QLabel" name="discoveryUrlLabel">
       <property name="text">
        <string>Discovery UR&amp;L</string>
       </property>
       <property name="buddy">
        <cstring>discoveryUrlEdit</cstring>
       </property>
      </widget>
     </item>
     <item row="6" column="1">
      <widget class="ElidedLineEdit" name="discoveryUrlEdit">
       <property name="placeholderText">
        <string notr="true">opc.tcp://localhost:4840</string>
       </property>
      </widget>
     </item>
     <item row="7" column="0">
      <widget class="QLabel" name="discoveryIntervalLabel">
       <property name="text">
        <string>Registration &amp;Interval</string>
       </property>
       <property name="buddy">
        <cstring>discoveryIntervalSpin</cstring>
       </property>
