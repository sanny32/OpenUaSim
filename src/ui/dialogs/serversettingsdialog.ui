     </item>
     <item row="7" column="1">
      <widget class="QSpinBox" name="discoveryIntervalSpin">
       <property name="toolTip">
        <string>How often the server renews its registration; keep it below the time the discovery server keeps a server</string>
       </property>
       <property name="suffix">
        <string> s</string>
       </property>
      </widget>
     </item>
     <item row="8" column="1">
      <widget class="QCheckBox" name="discoveryVerifyCheck">
       <property name="toolTip">
        <string>Register only at a discovery server whose certificate is trusted on the Certificates page; an unknown one is moved to the rejected folder</string>
       </property>
       <property name="text">
        <string>&amp;Verify the discovery server certificate</string>
       </property>
