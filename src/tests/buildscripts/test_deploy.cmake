cmake_minimum_required(VERSION 3.22)

set(PROJECT_NAME ouasim)
set(PRODUCT_NAME OpenUaSim)
set(OUASIM_DEPLOY_TOOL "${CMAKE_COMMAND}")
set(OUASIM_OPENSSL_BIN "${FIXTURE_ROOT}/missing-openssl")
set(OUASIM_WITH_ENCRYPTION OFF)
configure_file("${OUASIM_SOURCE_ROOT}/src/cmake/deploy_runtime.cmake.in"
    "${FIXTURE_ROOT}/deploy.cmake" @ONLY)
file(READ "${FIXTURE_ROOT}/deploy.cmake" deploy_script)

foreach(windows IN ITEMS TRUE FALSE)
    file(WRITE "${FIXTURE_ROOT}/run.cmake"
        "set(CMAKE_HOST_WIN32 ${windows})\nset(CMAKE_INSTALL_PREFIX \"${FIXTURE_ROOT}/stage\")\n${deploy_script}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${FIXTURE_ROOT}/run.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "Qt runtime deployment failed")
        message(FATAL_ERROR "Deployment failure was not propagated: ${output}${error}")
    endif()
endforeach()

set(OUASIM_WITH_ENCRYPTION ON)
configure_file("${OUASIM_SOURCE_ROOT}/src/cmake/deploy_runtime.cmake.in"
    "${FIXTURE_ROOT}/deploy.cmake" @ONLY)
file(READ "${FIXTURE_ROOT}/deploy.cmake" deploy_script)
file(WRITE "${FIXTURE_ROOT}/run.cmake" "set(CMAKE_HOST_WIN32 TRUE)\n${deploy_script}")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${FIXTURE_ROOT}/run.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "OpenSSL runtime DLLs not found")
    message(FATAL_ERROR "Missing OpenSSL was not rejected: ${output}${error}")
endif()

function(test_runtime windows config failure)
    set(stage "${FIXTURE_ROOT}/runtime ${windows} ${config} ${failure}")
    file(WRITE "${stage}/calls.txt" "")
    set(OUASIM_WITH_ENCRYPTION OFF)
    set(OUASIM_CODESIGN_TOOL "${CMAKE_COMMAND}")
    configure_file("${OUASIM_SOURCE_ROOT}/src/cmake/deploy_runtime.cmake.in"
        "${FIXTURE_ROOT}/deploy.cmake" @ONLY)
    file(READ "${FIXTURE_ROOT}/deploy.cmake" deploy_script)
    string(REPLACE "COMMAND \"${CMAKE_COMMAND}\""
        "COMMAND \"${CMAKE_COMMAND}\" \"-DTEST_WINDOWS=${windows}\" \"-DTEST_CONFIG=${config}\" \"-DTEST_FAILURE=${failure}\" \"-DTEST_STAGE=${stage}\" -P \"${OUASIM_SOURCE_ROOT}/src/tests/buildscripts/mock_deploy.cmake\""
        deploy_script "${deploy_script}")
    file(WRITE "${FIXTURE_ROOT}/run.cmake"
        "set(CMAKE_HOST_WIN32 ${windows})\nset(CMAKE_INSTALL_CONFIG_NAME ${config})\nset(CMAKE_INSTALL_PREFIX \"${stage}\")\n${deploy_script}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${FIXTURE_ROOT}/run.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(failure STREQUAL none)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Runtime deployment failed: ${output}${error}")
        endif()
    else()
        if(failure STREQUAL deploy)
            set(expected_error "Qt runtime deployment failed")
        elseif(failure STREQUAL sign)
            set(expected_error "Bundle signing failed")
        else()
            set(expected_error "Bundle signature verification failed")
        endif()
        if(result EQUAL 0 OR NOT error MATCHES "${expected_error}")
            message(FATAL_ERROR "${failure} failure was not propagated: ${output}${error}")
        endif()
    endif()
    file(READ "${stage}/calls.txt" calls)
    if(windows OR failure STREQUAL deploy)
        set(expected_calls "deploy\n")
    elseif(failure STREQUAL sign)
        set(expected_calls "deploy\nsign\n")
    else()
        set(expected_calls "deploy\nsign\nverify\n")
    endif()
    if(NOT calls STREQUAL expected_calls)
        message(FATAL_ERROR "Unexpected deployment sequence: ${calls}")
    endif()
endfunction()

foreach(config IN ITEMS Debug Release)
    test_runtime(TRUE ${config} none)
    test_runtime(FALSE ${config} none)
endforeach()
test_runtime(FALSE Release deploy)
test_runtime(FALSE Release sign)
test_runtime(FALSE Release verify)
