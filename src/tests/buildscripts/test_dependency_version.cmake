cmake_minimum_required(VERSION 3.22)
include("${OUASIM_SOURCE_ROOT}/src/cmake/dependency_version.cmake")

ouasim_dependency_revision("${OUASIM_SOURCE_ROOT}" "2.3.4" revision)
if(NOT revision STREQUAL "2.3.4")
    message(FATAL_ERROR "The declared dependency version must take priority over Git")
endif()

find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${OUASIM_SOURCE_ROOT}" rev-parse --short=12 HEAD
    RESULT_VARIABLE result OUTPUT_VARIABLE expected OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot read the fixture checkout commit")
endif()
ouasim_dependency_revision("${OUASIM_SOURCE_ROOT}" "" revision)
if(NOT revision STREQUAL expected)
    message(FATAL_ERROR "A dependency without a version must use its checkout commit")
endif()

ouasim_dependency_revision("${OUASIM_SOURCE_ROOT}/src/tests" "" revision)
if(NOT revision STREQUAL "")
    message(FATAL_ERROR "An archive must not inherit the application checkout commit")
endif()

ouasim_dependency_revision("${FIXTURE_ROOT}" "" revision)
if(NOT revision STREQUAL "")
    message(FATAL_ERROR "A source directory without Git metadata must report no revision")
endif()

set(CMAKE_DISABLE_FIND_PACKAGE_Git TRUE)
unset(GIT_FOUND)
ouasim_dependency_revision("${OUASIM_SOURCE_ROOT}" "" revision)
if(NOT revision STREQUAL "")
    message(FATAL_ERROR "An unavailable Git executable must report no revision")
endif()
ouasim_dependency_revision("${FIXTURE_ROOT}" "2.3.4" revision)
if(NOT revision STREQUAL "2.3.4")
    message(FATAL_ERROR "A declared version must work without Git")
endif()
